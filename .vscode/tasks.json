{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-debug",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project",
                "${workspaceFolder}/GenesisTerminal.xcodeproj",
                "-scheme",
                "GenesisTerminal",
                "-configuration",
                "Debug",
                "-derivedDataPath",
                "${workspaceFolder}/.build",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
